<?xml version="1.0" encoding="UTF-8"?>

<worksheet  xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Skills Check 5</title>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>f(x) = 3x^{4}-5x^{-2}+2x-5</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(x) = \cos(3\nexp{x})</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>q(t) = \sin\left(\dfrac{-4}{3t^{2}-2}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>p(r) = \dfrac{r^{4}-5r^{3}+2r}{6r-5}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>h(x) = \dfrac{x^{2}+x+1}{(x^{3}+x^{2})^{5}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>m(t) = \nexp{\cos(3t^{4}-2)}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>r(x) = \left(\dfrac{1}{\sqrt[5]{x}}-5x\right)\left(x^{4}-\dfrac{1}{2x^{6}}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>T(z) = z^{5}\cos(z)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(w) = \nexp{\sqrt[4]{5w+3}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>F(x) = \dfrac{3}{4x^{3}} - x^{-2/3}</m>
		</p>
	</statement>
</exercise>
</worksheet>
