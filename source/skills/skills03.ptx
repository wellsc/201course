<?xml version="1.0" encoding="UTF-8"?>

<worksheet  xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Skills Check 3</title>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>f(x) = 2x^{4}-5x^{2}+12x-5</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(x) = \cos(\nexp{x})</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>q(t) = \tan\left(\dfrac{1}{3t-2}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>p(r) = \dfrac{r^{4}-5r^{2}+r}{2r+5}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>h(x) = \dfrac{2x^{3}+3x^{2}}{{(x^{3}+x^{2})}^{4}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>m(t) = \nexp{\cos(2t^{2}-5)}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>r(x) = \left(\dfrac{1}{\sqrt[4]{x}}-4x\right)\left(x^{4}-\dfrac{1}{2x^{4}}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>T(z) = z^{4}\tan(z)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(w) = \nexp{\sqrt[3]{2w}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>F(x) = -\dfrac{1}{3x^{4}} - x^{-3/5}</m>
		</p>
	</statement>
</exercise>
</worksheet>
