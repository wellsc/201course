<?xml version="1.0" encoding="UTF-8"?>

<worksheet  xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Skills Check 4</title>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>f(x) = 4x^{8}+2x^{6}-5x^{2}+12x-5</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(x) = \cos(\nexp{2x})</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>q(t) = \cos\bigg(\dfrac{3}{2t^{2}-5t}\bigg)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>p(r) = \dfrac{r^{5}-2r^{3}+8r}{4r-5}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>h(x) = \dfrac{2x^{3}+3x^{2}}{(x^{2}-2)^{4}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>m(t) = \nexp{\tan(2t^{3}-5t)}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>r(x) = \bigg(\dfrac{1}{\sqrt[5]{2x}}-5x\bigg)\bigg(x^{5}-\dfrac{1}{3x^{4}}\bigg)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>T(z) = z^{3}\sin(z)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(w) = \nexp{\sqrt[4]{3w}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>F(x) = -\dfrac{1}{4x^{3}} + 3x^{-2/5}</m>
		</p>
	</statement>
</exercise>
</worksheet>
