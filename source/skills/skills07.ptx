<?xml version="1.0" encoding="UTF-8"?>

<worksheet  xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Skills Check 7</title>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>f(x) = -6x^{7}-5x^{3}+5x-5</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(x) = 2\cos(3\nexp{-2x})</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>q(t) = \sin\left(\dfrac{3}{3t^{4}+2t}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>p(r) = \dfrac{r^{4}-4r^{2}+5}{r^{2}-1}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>h(x) = \dfrac{x^{2}-4x+1}{(x^{2}+5)^{3}}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>m(t) = \nexp{\sin(t^{3}+4t^{2})}</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>r(x) = \left(\dfrac{1}{\sqrt[4]{x^{2}+1}}-5x\right)\left(x^{3}-\dfrac{3}{5x^{3}}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>T(z) = z^{3}\sin(z)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>g(w) = \sin\left({\sqrt[3]{5w-2}}\right)</m>
		</p>
	</statement>
</exercise>
  <exercise workspace='1in'>
	<statement>
		<p>
			<m>F(x) = \dfrac{1}{4x^{3}} - \dfrac{x^{-3/5}}{3}</m>
		</p>
	</statement>
</exercise>
</worksheet>
