<?xml version="1.0" encoding="UTF-8"?>

<prefigure xmlns="https://prefigure.org" label="prefig_cubic_implicit">
<diagram dimensions="(650,650)" margins="35">
  <definition>f(x,y)=x^3-18*x*y-y^3</definition>
  <definition>p1 = (-9,9)</definition>
  <definition>p2 = (-4,8)</definition>
  <definition>p3 = (-8,4)</definition>
  <definition>slope(x,y)=(x^2-6*y)/(6*x+y^2)</definition>
  <definition>l1(x)=slope(p1[0],p1[1])*(x-p1[0])+p1[1]</definition>
  <definition>l2(x)=slope(p2[0],p2[1])*(x-p2[0])+p2[1]</definition>
  <definition>l3(x)=slope(*p3)*(x-p3[0])+p3[1]</definition>
  <definition>yv=6*2^(1/3)</definition>
  <definition>xv=-(yv*yv)/6</definition>
  <definition>v=(xv,yv)</definition>
  <coordinates bbox="(-12,-12,12,12)">
    <grid-axes
      xlabel="x"
      ylabel="y"
      spacings="((-12,1,12),(-12,1,12))"
      vlabels="(-12,2,12)"
      hlabels="(-12,2,12)"
    />
   <implicit-curve at="curve" function="f" k="0" stroke="green" />
   <graph at="line1" function="l1" stroke="blue" />
   <graph at="line2" function="l2" stroke="red" />
   <graph at="line3" function="l3" stroke="orange"/>
   <point p="p1" alignment="nw"><m>p_{1}=(${p1[0]},${p1[1]})</m></point>
   <point p="p2" alignment="ne" ><m>p_{2}=(${p2[0]},${p2[1]})</m></point>
   <point p="p3" alignment="ne" ><m>p_{3}=(${p3[0]},${p3[1]})</m></point>
   <definition>x12=intersect((l1,l2),-7,(-8,-7))</definition>
   <point p="(x12,l1(x12))" ></point>
   <definition>x13=intersect((l1,l3),-11,(-12,-10))</definition>
   <point p="(x13,l1(x13))" ></point>
   <definition>x23=intersect((l2,l3),-24,(-25,-22))</definition>
   <legend anchor="(bbox[2],bbox[3])"
            alignment="sw" opacity="0.9"
            scale="0.9" vertical-skip="10">
            <item ref="curve"><m>x^3-y^3=18xy</m></item>
            <item ref="line1">Tangent at <m>(${p1[0]},${p1[1]})</m></item>
            <item ref="line2">Tangent at <m>(${p2[0]},${p2[1]})</m></item>
            <item ref="line3">Tangent at <m>(${p3[0]},${p3[1]})</m></item>
    </legend>
  </coordinates>

</diagram>
</prefigure>
