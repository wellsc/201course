<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="prefigure_water_tank" >
        <diagram dimensions="(300,300)" margins="5">
          <definition>f(x)=sqrt(9-x^2)/3</definition>
          <definition>g(x)=-sqrt(9-x^2)/3</definition>
          <definition>h(x)=sqrt(9/4-x^2)/2-2</definition>
          <definition>k(x)=-sqrt(9/4-x^2)/2-2</definition>
          <definition>x1=-3*sqrt(15)/4</definition>
          <definition>x2=3*sqrt(15)/4.007</definition>

          <coordinates bbox="(-5,-7,5,3)">
            <graph function="f" domain="(-3,3)" stroke="black"/>
            <graph function="g" domain="(-3,3)" stroke="black"/>
            <polygon points="((-1.5,-2),(0,-4),(1.5,-2))" fill="blue" />
            <graph function="h" domain="(-1.5,1.5)" stroke="gray" fill="blue"/>
            <graph function="k" domain="(-1.5,1.5)" stroke="gray"/>
            <tangent-line function="g" point="x1" domain="(x1,-0.08)" stroke="black"/>
            <tangent-line function="g" point="x2" domain="(-0.08,x2)" stroke="black"/>
          </coordinates>
</diagram>
</prefigure>
