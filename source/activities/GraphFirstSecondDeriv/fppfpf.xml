<?xml version="1.0" encoding="UTF-8"?>
<prefigure xmlns="https://prefigure.org" label="fppfpf" >
<diagram dimensions="(600,600)" margins="15">
  <definition>f(x)=sqrt(3*x^2+4)-3</definition>
  <derivative name="fp" function="f"/>
  <derivative name="fpp" function="fp"/>
  <coordinates bbox="(-3,-3,3,3)">
    <grid-axes xlabel="x" ylabel="y" spacings="((-3,1/2,3),(-3,1/2,3))"/>
    <graph at="graph"  function="f"    thickness="4" dash="16 4 4 4" stroke="blue" />
    <graph at="deriv"  function="fp"   thickness="4" dash="4 4"      stroke="black" />
    <graph at="deriv2" function="fpp"  thickness="4"                 stroke="green" />
  </coordinates>

  <annotations text="The graph of a function and its tangent line at the point a equals 1">
    <annotation ref="graph-group" text="The graph and its tangent line">
      <annotation ref="graph" text="The graph of the function f" sonify="yes"/>
      <annotation ref="point" text="The point a comma f of a"/>
      <annotation ref="tangent" text="The tangent line to the graph of f at the point"/>
    </annotation>
  </annotations>
</diagram>
</prefigure>
