<?xml version="1.0" encoding="UTF-8"?>

<worksheet  xmlns:xi="http://www.w3.org/2001/XInclude">
        <title>Related Rate Problems</title>
      <exercise  xml:id="change-in-area-for-a-circle">
          <title>Change in Area for a Circle</title>
		<statement>
        <p>
          A circle is increasing in size over time in such a way that
          its radius is increasing at a rate of
          \(0.03\frac{\text{cm}}{\text{s}}\).
        </p>
        <p>
          At what rate is the area of the circle increasing when the
          radius is 33 cm?
        </p>
      		</statement>
	</exercise>
      <exercise xml:id="dumping-gravel">
          <title>Dumping Gravel</title>
		<statement>
        <p>
          Gravel is being dumped from a conveyor belt into a pile at a
          rate of \(30\frac{\text{ft}^{3}}{\text{min}}\). It forms a
          pile in the shape of a right circular cone whose base diameter
          and height are always equal.
        </p>
        <p>
          How fast is the height of the pile increasing when the pile is
          \(19\) feet high?
        </p>
      		</statement>
	</exercise>
      <exercise xml:id="speed-of-a-moving-spotlight">
          <title>Speed of a Moving Spotlight</title>
		<statement>
        <p>
          A spotlight is shining on a wall. The spotlight is 10 feet
          from the wall and the angle between the spotlight and the
          ground is increasing at a rate of 0.2 radians per second.
        </p>
        <p>
          How fast is the spot of light moving on the wall when the
          angle is \(\frac{\pi}{4}\) radians?
        </p>
      		</statement>
	</exercise>
      <exercise xml:id="filling-a-horizontal-cylindrical-tank">
          <title>Filling a Horizontal Cylindrical Tank</title>
		<statement>
        <p>
          A cylindrical tank lies on its side, and it is being filled
          with water at a rate of 3 cubic feet per minute. The tank has
          a radius of 4 feet and a length of 10 feet.
        </p>
        <p>
          In a horizontal tank with radius \(R\) and length \(L\), when
          the water has a depth of \(h\), the volume of water in the
          tank is given by 
         <md>
                 <mrow>
         V&amp;=\left(\frac{\pi }{2} - \arcsin\left(\frac{(R - h)}{R}\right)\right)LR^2 - L(R-h)\sqrt{\left(2Rh - h^{2}\right)}
                 </mrow>
                 <mrow>
          &amp;=\left(\arccos\left(\frac{(R - h)}{R}\right)\right)LR^2 - L(R-h)\sqrt{\left(2Rh - h^{2}\right)}
                 </mrow>
         </md>
          How fast is the water level rising when the water level is 2
          feet deep?
        </p>
      		</statement>
	</exercise>
</worksheet>
